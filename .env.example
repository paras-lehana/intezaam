# Intezaam — environment contract (copy to apps/server/.env for local runs).
# Every variable is optional: with none set, the app runs fully on its labelled offline planner.

# HTTP port the server listens on.
PORT=8080

# Google Gemini on the Gemini API free tier, server-side only, through an OpenAI-compatible LLM
# gateway. AI features switch on only when the URL and both keys are set together; otherwise every
# AI feature uses its deterministic offline fallback. Never commit real values.
# Outbound allow-list: https://llm.lehana.in or http://llm-service:8095 only. Any other value turns
# the AI off with a startup warning, and in production the server refuses to start.
LLM_SERVICE_URL=
# Sent as X-Internal-Key to the gateway.
LLM_SERVICE_KEY=
# The Gemini API's OpenAI-compatible endpoint (the only upstream allowed; this is the default).
LLM_UPSTREAM_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Gemini API key from a Google AI Studio project with no billing account.
LLM_UPSTREAM_KEY=
# Ordered model failover chain (fastest first); the first healthy model answers.
LLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Daily request budget per model, in the order above (90% of the free tier's 500 requests a day).
# Counts reset at midnight Pacific time; when every model is spent, the offline planner answers.
LLM_DAILY_LIMITS=450,450
# How the gateway's usage log names this app.
LLM_SERVICE_REF=intezaam
# Per model attempt, in milliseconds.
LLM_TIMEOUT_MS=45000

# Proxies in front of the app whose X-Forwarded-For entries are trusted. Behind Cloudflare + Traefik: 1
# (Traefik); the Cloudflare hop is handled by the client-key rule (CF-Connecting-IP is trusted only
# from Cloudflare's published ranges).
TRUST_PROXY_HOPS=1

# NODE_ENV comes from the Dockerfile (production): there, a refused outbound setting stops the server.
